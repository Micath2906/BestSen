	var pochi = load(\"res://assets/CatMegaFree/PochiFree/FreeSprites.png\")
	print(\"Pochi FreeSprites.png size: \", pochi.get_size() if pochi else \"null\")
	var retro = load(\"res://assets/RetroCatsFree.png\")
	print(\"RetroCatsFree.png size: \", retro.get_size() if retro else \"null\")
	get_tree().quit()
