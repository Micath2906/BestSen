grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_modal_panel")

[node name="VBox" type="VBoxContainer" parent="VictoryModal/ModalPanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VictoryModal/ModalPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.18, 0.62, 0.32, 1)
theme_override_font_sizes/font_size = 15
text = "🎉 DƯỢC SĨ BẢN LĨNH CỦA BẢN THÂN!"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="VictoryModal/ModalPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="DialogueLabel" type="Label" parent="VictoryModal/ModalPanel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.28, 0.22, 0.16, 1)
theme_override_font_sizes/font_size = 12
text = "Lời tuyên dương..."
autowrap_mode = 2

[node name="BtnClaimReward" type="Button" parent="VictoryModal/ModalPanel/VBox"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 12
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_primary")
text = "🎁 Nhận Thưởng (+35 Cá, Nhiệt Kế Đầu Mềm)"
