│  BẢN ĐỒ CHUYỂN TIẾP TRỌNG YẾU TP.HCM   │
└────────────────────────────────────────┘
 [KTX KHU B]
      │ (Bus 08 / 19)
      ▼
 [Trạm ĐHQG] (Chú ý đón đúng chiều ➔ Bến Thành)
      │
      ├──────────────────────┐ (Double-tap chuyển tiếp)
      ▼                      ▼
 [Chợ Thủ Đức] ⚠️ Ngập   [Ga Thủ Đức - Metro 1] ⚡ x2.5 tốc độ
      │                      │
      ▼                      ▼
 [Ngã 4 Hàng Xanh] ⚠️ Kẹt [Ga Tân Cảng - Metro 1]
      │                      │
      ▼                      ▼
 [Đinh Tiên Hoàng]       [Ga Ba Son / Nhà Hát TP]
      │                      │
      └──────────┬───────────┘
                 ▼
        [CỔNG TRƯỜNG ĐẠI HỌC] 🎓
        (Cập bến an toàn trước 60s)"
autowrap_mode = 2

[node name="TipLabel" type="Label" parent="InfographicModal/ModalPanel/VBox/Scroll/InfoVBox"]
