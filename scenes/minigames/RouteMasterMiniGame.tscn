theme_override_constants/separation = 10

[node name="MetroTitle" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.05, 0.35, 0.75, 1)
theme_override_font_sizes/font_size = 12
text = "🚇 1. TUYẾN METRO SỐ 1 (Bến Thành - Suối Tiên):"

[node name="MetroDesc" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.25, 0.2, 1)
theme_override_font_sizes/font_size = 10
text = "• Chiều dài: 19.7 km (11 ga trên cao, 3 ga ngầm).
• Chu kỳ Headway: 5 phút / chuyến.
• Ưu điểm vàng: Chạy làn riêng trên cao, tốc độ nhanh gấp 2.5 lần xe bus, hoàn toàn KHÔNG BỊ ẢNH HƯỞNG bởi ngập lụt hay ùn tắc giao thông.
• Các ga chuyển tiếp huyết mạch: Ga Thủ Đức, Ga Tân Cảng, Ga Ba Son, Ga Nhà Hát, Ga Bến Thành."
autowrap_mode = 2

[node name="BusTitle" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.45, 0.05, 1)
theme_override_font_sizes/font_size = 12
text = "🚌 2. CÁC TUYẾN XE BUS SINH VIÊN ĐHQG:"

[node name="BusDesc" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.25, 0.2, 1)
theme_override_font_sizes/font_size = 10
text = "• Tuyến 08: KTX ĐHQG - BX Quận 8 (trục đi học quốc dân của sinh viên làng đại học).
• Tuyến 19: Bến Thành - ĐHQG (chạy dọc trục Xa lộ Hà Nội).
• Tuyến 53: Lê Hồng Phong - ĐHQG.
• Tuyến 150: Chợ Lớn - Ngã 3 Tân Vạn.
• Điểm đen ngập nước: Chợ Thủ Đức / Kha Vạn Cân (mưa lớn nước dâng, xe bus giảm 70% tốc độ).
• Điểm đen kẹt xe: Ngã 4 Hàng Xanh vào giờ cao điểm sáng (xe bus giảm 90% tốc độ)."
autowrap_mode = 2

[node name="TipTitle" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.6, 0.3, 1)
theme_override_font_sizes/font_size = 12
text = "💡 3. BÍ KÍP THỔ ĐỊA VƯỢT TẮC ĐƯỜNG:"

[node name="TipDesc" type="Label" parent="HandbookModal/ModalPanel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.25, 0.2, 1)
theme_override_font_sizes/font_size = 10
text = "• Luôn để ý biển báo chiều đi của trạm bus: Đi trạm [➔ Bến Thành] để vào trung tâm trường; tuyệt đối không đón trạm [⬅ BX Miền Tây] kẻo ngược hướng trễ thi.
• Khi thấy điểm ngập nước (Chợ Thủ Đức) hoặc kẹt xe (Hàng Xanh), lập tức Double-tap vào trạm bus để CẮT DÂY và nối nhánh chuyển sang Ga Metro 1 trên cao!
• Tiêu hao 5 Cá Khô đổi tuyến sẽ cứu Sen thoát khỏi nguy cơ trễ học và bị cấm thi!"
autowrap_mode = 2

