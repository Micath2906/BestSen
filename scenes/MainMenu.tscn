theme_override_colors/font_color = Color(0.85, 0.45, 0.1, 1)
theme_override_font_sizes/font_size = 10
text = "🎒 16 KỸ NĂNG SINH TỒN THỰC CHIẾN:
• Đi Lại: Bắt xe buýt, ứng dụng BusMap, bảo dưỡng xe.
• Thuê Trọ: Soi hợp đồng, giấy CT07, thoát hiểm PCCC.
• Y Tế: Khám BHYT đúng tuyến, sơ cứu, trữ nước ấm.
• Tài Chính: Quy tắc 6 chiếc lọ, chống bẫy nợ BNPL."
autowrap_mode = 2

